# Documentation only; this file is not automatically loaded by the browser or CI.
# Public browser configuration. Copy these two values into app/config.js.
# SUPABASE_ANON_KEY accepts a publishable browser key or a legacy public anon key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Future server-side jobs only. A real value belongs in the job runner secret store
# or a protected file OUTSIDE the repository and every web document root.
# Never fill it into this file or a local .env under the served repository:
# python http.server can serve dotfiles; .gitignore is not access control.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
