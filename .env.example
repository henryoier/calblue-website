# Public browser configuration. Copy these two values into app/config.js.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side jobs only. Never put this value in app/, a committed file, or a
# deployed browser asset. A real value belongs in the job runner's secret store.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
